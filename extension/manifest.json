{
  "manifest_version": 3,
  "name": "Block",
  "version": "0.1.0",
  "description": "Bloquea webs que distraen mientras tienes una sesión de Block activa en este PC.",
  "permissions": ["declarativeNetRequest", "alarms", "storage"],
  "host_permissions": ["<all_urls>", "http://127.0.0.1:47613/*"],
  "background": { "service_worker": "background.js" },
  "web_accessible_resources": [{ "resources": ["blocked.html"], "matches": ["<all_urls>"] }]
}
